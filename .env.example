# Firebase Client Configuration Template
# copy this file to `.env` or `.env.local` and fill in your actual TEAMProde2026 Firebase keys.
# DO NOT commit the `.env` or `.env.local` files to public repositories.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=teamprode2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=teamprode2026
VITE_FIREBASE_STORAGE_BUCKET=teamprode2026.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
